{
  "manifest_version": 3,
  "name": "SecureOS Threat Shield",
  "version": "1.0.0",
  "description": "SecureOS real-time, privacy-focused offline phishing protection powered by machine learning and heuristic analysis.",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "declarativeNetRequest",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SecureOS Threat Shield",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "warning.html",
        "sandbox.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
